# Jellyfin Media Server Configuration

# Server Settings
JELLYFIN_VERSION=latest
JELLYFIN_PORT=8096
JELLYFIN_HTTPS_PORT=8920
TZ=Asia/Kolkata

# Directory Paths (customize these)
MEDIA_DIR=${HOME}/Media
CONFIG_DIR=${HOME}/jellyfin-config

# Network Settings
PUBLISHED_SERVER_URL=http://localhost:8096

# Hardware Acceleration (macOS)
# Options: none, videotoolbox
HW_ACCEL=videotoolbox

# Auto-restart policy
# Options: no, always, on-failure, unless-stopped
RESTART_POLICY=unless-stopped

# User/Group (for permissions)
PUID=1000
PGID=1000
